# Copy to .env and fill in real values. Never commit .env.
PORT=4000
NODE_ENV=development

# PostgreSQL connection string (docker-compose.yml exposes port 5432)
DATABASE_URL=postgresql://restaurant:restaurant@localhost:5432/restaurant_db?schema=public
# Separate database used by the automated tests (it is wiped by the tests!)
TEST_DATABASE_URL=postgresql://restaurant:restaurant@localhost:5432/restaurant_test?schema=public

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Token lifetime (jsonwebtoken format: 60, "2h", "1d", ...)
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed client origins (e.g. the Vite dev server)
CORS_ORIGIN=http://localhost:5173
# Deployed client URL (e.g. https://mytable.example.com), allowed in addition to CORS_ORIGIN
CLIENT_URL=
